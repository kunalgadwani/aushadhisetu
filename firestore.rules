rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(clinicId) {
      return /databases/$(database)/documents/clinics/$(clinicId)/members/$(request.auth.uid);
    }

    function isActiveClinicMember(clinicId) {
      return signedIn()
        && exists(memberPath(clinicId))
        && get(memberPath(clinicId)).data.status == "active";
    }

    function isDoctor(clinicId) {
      return isActiveClinicMember(clinicId)
        && get(memberPath(clinicId)).data.role == "doctor";
    }

    function belongsToClinic(clinicId) {
      return request.resource.data.clinicId == clinicId;
    }

    // Users collection: allow read own doc, allow write own doc
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      allow write: if signedIn() && request.auth.uid == userId;
    }

    // Clinic codes: allow read for receptionist lookup, allow create during onboarding
    match /clinicCodes/{code} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    // System counters: allow read/write for authenticated users (used for clinic ID allocation)
    match /systemCounters/{counterId} {
      allow read, write: if signedIn();
    }

    match /clinics/{clinicId} {
      allow read: if isActiveClinicMember(clinicId);
      // Allow create for onboarding (new clinic), allow update for doctor
      allow create: if signedIn()
        && request.resource.data.ownerUid == request.auth.uid;
      allow update: if isDoctor(clinicId);

      match /members/{uid} {
        allow read: if isActiveClinicMember(clinicId);
        // Allow create for onboarding (doctor adding self) and receptionist joining
        allow create: if signedIn()
          && (uid == request.auth.uid
            || request.resource.data.uid == request.auth.uid);
        // Allow update for doctor (managing receptionists) or self
        allow update: if isDoctor(clinicId) || (signedIn() && request.auth.uid == uid);
      }

      match /counters/{counterId} {
        allow read, write: if isActiveClinicMember(clinicId);
      }

      match /patients/{patientId} {
        allow read: if isActiveClinicMember(clinicId);
        allow create, update: if isActiveClinicMember(clinicId)
          && belongsToClinic(clinicId);
        allow delete: if isDoctor(clinicId);
      }

      match /medicines/{itemId} {
        allow read: if isActiveClinicMember(clinicId);
        allow create, update: if isActiveClinicMember(clinicId)
          && belongsToClinic(clinicId);
        allow delete: if isDoctor(clinicId);
      }

      match /tests/{itemId} {
        allow read: if isActiveClinicMember(clinicId);
        allow create, update: if isActiveClinicMember(clinicId)
          && belongsToClinic(clinicId);
        allow delete: if isDoctor(clinicId);
      }

      match /prescriptions/{itemId} {
        allow read: if isActiveClinicMember(clinicId);
        allow create, update: if isActiveClinicMember(clinicId)
          && belongsToClinic(clinicId);
        allow delete: if isDoctor(clinicId);
      }

      match /bills/{itemId} {
        allow read: if isActiveClinicMember(clinicId);
        allow create, update: if isActiveClinicMember(clinicId)
          && belongsToClinic(clinicId);
        allow delete: if isDoctor(clinicId);
      }

      match /visits/{itemId} {
        allow read: if isActiveClinicMember(clinicId);
        allow create, update: if isActiveClinicMember(clinicId)
          && belongsToClinic(clinicId);
        allow delete: if isDoctor(clinicId);
      }

      match /attendance/{itemId} {
        allow read: if isActiveClinicMember(clinicId);
        allow create, update: if isDoctor(clinicId)
          && belongsToClinic(clinicId);
        allow delete: if isDoctor(clinicId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
